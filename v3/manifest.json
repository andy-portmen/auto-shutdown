{
  "manifest_version": 3,
  "version": "0.2.1",
  "name": "Auto Shutdown",
  "description": "Executes a system-level command to shut down, hibernate or standby your operating system when all downloads are finished",
  "permissions": [
    "storage",
    "nativeMessaging",
    "downloads",
    "power"
  ],
  "background": {
    "service_worker": "worker.js",
    "scripts": ["worker.js"]
  },
  "icons": {
    "16": "/data/icons/16.png",
    "32": "/data/icons/32.png",
    "48": "/data/icons/48.png",
    "64": "/data/icons/64.png",
    "128": "/data/icons/128.png",
    "256": "/data/icons/256.png",
    "512": "/data/icons/512.png"
  },
  "action": {},
  "homepage_url": "https://add0n.com/auto-shutdown.html",
  "options_ui": {
    "page": "/data/options/index.html"
  },
  "commands": {
    "_execute_action": {}
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{9a71ec90-d0b6-44af-833f-efe418ff8454}",
      "strict_min_version": "128.0"
    }
  }
}
